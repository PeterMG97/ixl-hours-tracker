{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "*.exe",
      "*.ps1",
      "*.bat",
      "*.xlsx",
      "*.md",
      "*.yaml",
      "server.js",
      "data.backup.json",
      "test_*.js",
      "welcome_pic/**",
      "welcome_pic_mob/**",
      "*.pdf"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|jpg|jpeg|png|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
